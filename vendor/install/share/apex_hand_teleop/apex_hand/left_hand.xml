<mujoco model="left_apex_hand">
  <!-- 1. 全局配置：设置角度单位、关闭重力和碰撞 -->
  <compiler angle="radian"/>
  <default>
    <!-- contype="1" 表示手部零部件属于第 1 类物体
         conaffinity="2" 表示手部零部件只想和第 2 类物体（外部物体）发生碰撞。
         因为 1 和 2 的二进制位不重叠，所以手部自身零部件之间将永远免疫碰撞！ -->
    <geom contype="1" conaffinity="1"/>
    <joint armature="0.001" damping="0.05"/>
  </default>
  <option gravity="0 0 0" timestep="0.0005">
    <!-- 调整解算器迭代次数(iterations)和软约束阻尼(implicit)
         让接触解算更硬、更稳定，彻底消除数值震荡抽搐 -->
    <flag constraint="enable" contact="enable"/>
  </option>

